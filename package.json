{
  "name": "obsidian-email-viewer",
  "version": "1.0.1",
  "description": "View .eml, .emlx, .mbox and .msg email files directly inside Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --alias:iconv-lite=./src/shims/iconv-lite.ts --outdir=build/tests --out-extension:.js=.cjs --log-level=warning && node --test build/tests/*.cjs",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "email",
    "eml",
    "msg",
    "mbox"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "linkedom": "^0.18.15",
    "obsidian": "^1.14.4",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.29.0",
    "postal-mime": "^4.2.1"
  },
  "author": "Maximilian Schwärzler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilian-schwaerzler/obsidian-email-viewer.git"
  }
}
